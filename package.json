{
  "name": "doctor-com-questionnaire",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --config client/vite.config.ts\" \"tsx watch server/index.ts\"",
    "build": "npm run typecheck:client && npm run typecheck:server && npm run build:server && vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "start:server": "node dist/server/index.js",
    "test": "tsx --test server/validation.test.ts server/scoring.test.ts server/plan.test.ts server/pdf.test.ts server/htmlPdf.test.ts server/reportJobs.test.ts server/googleSheets.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^183.0.0",
    "pdfkit": "^0.20.2",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.32.1",
    "sanitize-html": "^2.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
